# --- MongoDB (the FriendlyFire bot's Atlas cluster) ---
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/
# Database used by the quiz. Use phoenixquiz_dev locally.
MONGODB_DB=phoenixquiz

# --- Auth.js ---
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=change-me
# Public URL of the app: https://app.phxlgc.com in production (Cloudflare tunnel), localhost in dev
AUTH_URL=https://app.phxlgc.com
AUTH_TRUST_HOST=true

# --- Discord (FriendlyFire's application: OAuth2 page) ---
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
# Guild whose nickname / server avatar are shown in the quiz
DISCORD_GUILD_ID=
# Comma-separated Discord user IDs that are always super-admins
SUPERADMIN_DISCORD_ID=

# --- Dev only: enables a fake "dev login" (ignored in production) ---
DEV_LOGIN=false

# --- Cloudflare tunnel (docker-compose cloudflared service) ---
TUNNEL_TOKEN=

PORT=3000
